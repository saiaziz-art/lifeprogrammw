# Copy to .env (never commit .env).

# Master key that encrypts stored integration credentials. Generate with: plot keygen
PLOT_SECRET_KEY=

# production | development | sandbox
# sandbox = a separate test environment with its own database (PLOT_DATABASE_URL), clearly
# labelled mock owners (plot sandbox-seed), and mailbox/postal integrations disabled.
PLOT_ENV=production

# Public URL of the web app; OAuth redirect URI is <PLOT_PUBLIC_URL>/api/mail/oauth/callback
PLOT_PUBLIC_URL=http://localhost:3000

# Database password used by docker-compose
POSTGRES_PASSWORD=change-me

# Identify yourself politely to public APIs (shown in the User-Agent)
PLOT_HTTP_CONTACT=private land research; contact you@example.com

# Daily run schedule (also editable in Admin → Health & runs)
PLOT_DAILY_CRON=0 7 * * *
PLOT_DAILY_TIMEZONE=Europe/London

# Cookies are Secure by default in production. If you serve PLOT over plain HTTP on a
# private network, set this to false (prefer putting it behind HTTPS instead).
# PLOT_COOKIE_SECURE=false
